# ========== XHS-Forge 核心配置模板 (复制为 .env 使用) ==========

# ----------------------------------------------------------------
# 1. 【中央主脑】(Central Brain) - 负责意图识别、文案生成、排版布局
#    支持所有兼容 OpenAI SDK 的大模型 (如阿里云 Qwen, DeepSeek, Moonshot 等)
# ----------------------------------------------------------------
LLM_API_KEY=sk-your-llm-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max
LLM_SMALL_MODEL=qwen-plus

# ----------------------------------------------------------------
# 2. 【感知与记忆矩阵】(Perception & Memory) - 智谱全家桶
#    负责：联网搜索 (Web Search), AI 绘图 (CogView), 识图 (GLM-4V), 向量化 (Embedding)
#    当前向量化使用智谱 embedding-3，无需单独配置 EMBEDDING_*；若改用 OpenAI 兼容接口可填写下方两项
# ----------------------------------------------------------------
ZHI_PU_API_KEY=your-zhipu-api-key
# EMBEDDING_API_KEY=   # 可选，使用 OpenAI 兼容 Embedding 时填写
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# ----------------------------------------------------------------
# 3. 【基础设施】(Infrastructure) - 数据库与缓存
#    Docker 环境下通常保持默认，宿主机开发需修改 Host
# ----------------------------------------------------------------
# Redis 连接 (默认带密码 qq15160160)
REDIS_URL=redis://:qq15160160@redis:6379/0

# PostgreSQL 连接 (默认带密码 qq151601601)
POSTGRES_URL=postgresql://postgres:qq151601601@postgres:5432/LangChainProject
PGVector_URL=postgresql+psycopg://postgres:qq151601601@postgres:5432/LangChainProject

# ----------------------------------------------------------------
# 4. 【对象存储】(Object Storage) - 笔记图片与 HTML 托管
#    支持 AWS S3, MinIO, 阿里云 OSS 等 S3 兼容协议
# ----------------------------------------------------------------
OFFLOAD_BACKEND=s3
S3_ENDPOINT_URL=https://oss-cn-hangzhou.aliyuncs.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=xhs-forge-assets
S3_REGION=oss-cn-hangzhou
S3_SIGNATURE_VERSION=s3v4

# ----------------------------------------------------------------
# 5. 【物理世界锚点】(LBS) - 可选
#    高德地图 Web 服务 Key (用于 POI 探店、地理位置解析)
# ----------------------------------------------------------------
AMAP_WEB_SERVICE_KEY=

# ----------------------------------------------------------------
# 6. 【备用搜索】(Backup Search) - 可选
#    SerpAPI (Google Search) - 仅在智谱搜索不可用时作为备选
# ----------------------------------------------------------------
SERPAPI_API_KEY=
NETWORK_SEARCH_BACKEND=zhipu  # zhipu | serpapi

# ----------------------------------------------------------------
# 7. 【LangSmith 监控】(Observability) - 可选
#    用于追踪 Agent 的思考链路和 Token 消耗
# ----------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=XHS-Forge
