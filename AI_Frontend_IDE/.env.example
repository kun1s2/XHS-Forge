# ========== 后端必填配置（复制本文件为 .env 并填写真实值）==========
# 说明：缺少任一项都会报 ValidationError，需在 .env 中全部配置。

# ----- LLM（大模型 API，如 OpenAI 兼容 / 智谱 / 其他）-----
LLM_API_KEY=sk-your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_SMALL_MODEL=gpt-4o-mini

# ----- 智谱（联网检索、图片等，若不用可填占位）-----
ZHI_PU_API_KEY=your-zhipu-api-key

# ----- PostgreSQL（主库 + 向量库）-----
POSTGRES_URL=postgresql+psycopg://user:password@localhost:5432/your_db
PGVector_URL=postgresql+psycopg://user:password@localhost:5432/your_db

# ----- Embedding（向量化，如 OpenAI）-----
EMBEDDING_API_KEY=sk-your-embedding-key
# EMBEDDING_BASE_URL 有默认值，可不写
# EMBEDDING_MODEL 默认 text-embedding-3-small

# ----- S3 / 对象存储（笔记附件、上传等）-----
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET 默认 agent，S3_REGION 默认 us-east-1

# ----- 服务监听（端口转发 / 本机浏览器访问时必改）-----
# API_HOST=0.0.0.0   # 默认 127.0.0.1；改为 0.0.0.0 后可在 Cursor/VS Code 中转发 8000 端口，在本地浏览器访问
# API_PORT=8000      # 后端端口，需与前端 VITE_API_BASE_URL / WebSocket 一致

# ----- 可选 -----
# LANGSMITH_API_KEY=   # LangSmith 追踪
# AMAP_WEB_SERVICE_KEY=  # 高德地图
# SERPAPI_API_KEY=      # 联网检索用 SerpAPI 时
