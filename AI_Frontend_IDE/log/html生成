    <style>
        :root { --primary-vibe: #FF2D55; --primary-vibe-light: rgba(255, 45, 85, 0.1); --accent-vibe: #FFCC00; --spacing-sm: 16px; --spacing-md: 24px; --spacing-lg: 40px }
        body { 
            background-color: var(--bg-color, #f5f5f5); 
